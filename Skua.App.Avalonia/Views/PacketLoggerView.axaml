<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:uc="clr-namespace:Skua.App.Avalonia.UserControls"
             x:Class="Skua.App.Avalonia.Views.PacketLoggerView">

  <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
    <!-- Start/stop and state -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,2">
      <Button Grid.Column="0"
              Classes="skua-button w140"
              Classes.skua-danger="{Binding IsReceivingPackets}"
              Classes.skua-primary="{Binding !IsReceivingPackets}"
              Command="{Binding ToggleLoggingCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <materialIcons:MaterialIcon Kind="PlayCircleOutline" Width="15" Height="15" IsVisible="{Binding !IsReceivingPackets}" />
          <materialIcons:MaterialIcon Kind="StopCircleOutline" Width="15" Height="15" IsVisible="{Binding IsReceivingPackets}" />
          <TextBlock Text="{Binding StartStopText}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Border Grid.Column="2" Classes="chip success" IsVisible="{Binding IsReceivingPackets}">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <Ellipse Width="6" Height="6" Fill="{DynamicResource SkuaSuccessBrush}" VerticalAlignment="Center" />
          <TextBlock Text="Logging" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Search and filters -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox Grid.Column="0" PlaceholderText="Search packets" Text="{Binding PacketSearchText}">
        <TextBox.InnerLeftContent>
          <materialIcons:MaterialIcon Kind="Magnify" Width="15" Height="15" Margin="10,0,0,0" Foreground="{DynamicResource SkuaMutedTextBrush}" />
        </TextBox.InnerLeftContent>
      </TextBox>
      <uc:PacketFiltersButton Grid.Column="1" />
    </Grid>

    <!-- Logged packets: Ctrl+C or the context menu copies the selection -->
    <ListBox x:Name="PacketsListBox"
             Grid.Row="2"
             ItemsSource="{Binding FilteredPacketLogs}"
             SelectionMode="Multiple"
             KeyDown="PacketsListBox_KeyDown"
             SelectionChanged="PacketsListBox_SelectionChanged"
             Padding="4"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             FontFamily="JetBrains Mono,Consolas,Courier New,monospace"
             FontSize="11"
             Foreground="{DynamicResource SkuaTextBrush}">
      <ListBox.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Copy" Click="Copy_Click">
            <MenuItem.Icon>
              <materialIcons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Unselect all" Click="UnselectAll_Click" />
        </ContextMenu>
      </ListBox.ContextMenu>
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="8,3" />
          <Setter Property="MinHeight" Value="22" />
          <Setter Property="CornerRadius" Value="4" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Count and actions -->
    <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
      <TextBlock Grid.Column="0" x:Name="CountText" Text="0 packets" FontSize="11" VerticalAlignment="Center"
                 Foreground="{DynamicResource SkuaMutedTextBrush}" />
      <Button Grid.Column="1" x:Name="UnselectButton" Classes="icon icon-muted" IsVisible="False"
              ToolTip.Tip="Unselect all" Click="UnselectAll_Click">
        <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" />
      </Button>
      <Button Grid.Column="3" Classes="skua-button small w84" Click="Copy_Click" ToolTip.Tip="Copy the selected packets, or all of them">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <materialIcons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
          <TextBlock Text="Copy" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="4" Classes="skua-button small w84" Command="{Binding SavePacketLogsCommand}">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <materialIcons:MaterialIcon Kind="ContentSave" Width="14" Height="14" />
          <TextBlock Text="Save" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="5" Classes="skua-button small skua-danger-soft w84" Command="{Binding ClearPacketLogsCommand}">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14" />
          <TextBlock Text="Clear" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>
  </Grid>
</UserControl>
