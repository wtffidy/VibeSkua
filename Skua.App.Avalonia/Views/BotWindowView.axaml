<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels"
             xmlns:viewModels="clr-namespace:Skua.Shared.Avalonia.ViewModels;assembly=Skua.Shared.Avalonia"
             x:Class="Skua.App.Avalonia.Views.BotWindowView"
             x:DataType="vms:BotWindowViewModel">
  <Grid RowDefinitions="Auto,*" Margin="8" RowSpacing="8">
    <!-- Top Toolbar Navigation -->
    <Border Grid.Row="0"
            Background="{DynamicResource SkuaSurfaceBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8,6">
      <DockPanel LastChildFill="True">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <!-- Toggle Sidebar -->
          <ToggleButton Classes="top-nav-item"
                        IsChecked="{Binding IsSidebarOpen, Mode=TwoWay}"
                        ToolTip.Tip="Toggle Tools Sidebar">
            <materialIcons:MaterialIcon Kind="Menu" Width="14" Height="14" />
          </ToggleButton>

          <!-- Back -->
          <Button Classes="top-nav-item"
                  Command="{Binding MovePrevCommand}"
                  ToolTip.Tip="Previous Tool">
            <materialIcons:MaterialIcon Kind="ArrowLeft" Width="14" Height="14" />
          </Button>

          <!-- Forward -->
          <Button Classes="top-nav-item"
                  Command="{Binding MoveNextCommand}"
                  ToolTip.Tip="Next Tool">
            <materialIcons:MaterialIcon Kind="ArrowRight" Width="14" Height="14" />
          </Button>

          <!-- Home -->
          <Button Classes="top-nav-item"
                  Command="{Binding HomeCommand}"
                  ToolTip.Tip="First Tool">
            <materialIcons:MaterialIcon Kind="Home" Width="14" Height="14" />
          </Button>

          <Border Width="1" Height="16" Margin="4,0" Background="{DynamicResource SkuaBorderBrush}" VerticalAlignment="Center" />

          <TextBlock Text="{Binding SelectedItem.Title}"
                     FontWeight="Bold"
                     FontSize="13"
                     Foreground="{DynamicResource SkuaTextBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Main Content Area -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
      <!-- Collapsible Tools Sidebar -->
      <Border Grid.Column="0"
              Background="{DynamicResource SkuaSurfaceBrush}"
              BorderBrush="{DynamicResource SkuaBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Width="220"
              Padding="8"
              IsVisible="{Binding IsSidebarOpen}">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" Margin="0,0,0,8">
            <TextBox Height="32"
                     CornerRadius="6"
                     VerticalContentAlignment="Center"
                     Padding="28,0,8,0"
                     PlaceholderText="Search tools..."
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <materialIcons:MaterialIcon Kind="Magnify"
                                        Width="14" Height="14"
                                        Foreground="{DynamicResource SkuaMutedTextBrush}"
                                        HorizontalAlignment="Left"
                                        Margin="8,0,0,0"
                                        IsHitTestVisible="False" />
          </Grid>

          <ListBox Grid.Row="1"
                   Classes="embedded"
                   ItemsSource="{Binding FilteredBotItems}"
                   SelectedItem="{Binding SelectedItem}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vms:BotWindowItemViewModel">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,2">
                  <materialIcons:MaterialIcon Kind="WindowMaximize" Width="13" Height="13" Foreground="{DynamicResource SkuaAccentBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- Selected Tool View -->
      <Border Grid.Column="1"
              Background="{DynamicResource SkuaSurfaceBrush}"
              BorderBrush="{DynamicResource SkuaBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="6"
              ClipToBounds="True">
        <ContentControl Content="{Binding CurrentView}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
      </Border>
    </Grid>
  </Grid>
</UserControl>
