<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework Condition="'$(TargetFramework)' == '' and '$(OS)' == 'Windows_NT'">net10.0-windows</TargetFramework>
        <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <OutputType Condition="'$(TargetFramework)' == 'net10.0-windows'">WinExe</OutputType>
        <RuntimeIdentifiers Condition="'$(TargetFramework)' == 'net10.0-windows'">win-x64;win-x86</RuntimeIdentifiers>
        <RuntimeIdentifiers Condition="'$(TargetFramework)' == 'net10.0'">osx-arm64;osx-x64</RuntimeIdentifiers>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>VibeSkua</AssemblyName>
        <AssemblyTitle>VibeSkua</AssemblyTitle>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
        <UseWindowsForms>true</UseWindowsForms>
        <DefineConstants>$(DefineConstants);IS_WINDOWS</DefineConstants>
        <ApplicationIcon>../Skua.Shared.Avalonia/Assets/SkuaIcon.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">
        <RuffleRustTarget>aarch64-apple-darwin</RuffleRustTarget>
    </PropertyGroup>
    <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64'">
        <RuffleRustTarget>x86_64-apple-darwin</RuffleRustTarget>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyMetadata Include="Skua.ClientId" Value="VibeSkuaAvalonia" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
        <Reference Include="AxInterop.ShockwaveFlashObjects">
            <HintPath>Assemblies/AxInterop.ShockwaveFlashObjects.dll</HintPath>
        </Reference>
        <Reference Include="Interop.ShockwaveFlashObjects">
            <HintPath>Assemblies/Interop.ShockwaveFlashObjects.dll</HintPath>
        </Reference>
        <PackageReference Include="CoreHook" />
        <Content Include="Assemblies/corehook32.dll" Link="corehook32.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Assemblies/corehook64.dll" Link="corehook64.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Assemblies/coreload32.dll" Link="coreload32.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Assemblies/coreload64.dll" Link="coreload64.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <None Update="app.manifest">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Velopack" />
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Controls.ColorPicker" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
        <PackageReference Include="Material.Avalonia" />
        <PackageReference Include="Material.Icons" />
        <PackageReference Include="Material.Icons.Avalonia" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Skua.Core/Skua.Core.csproj" />
        <ProjectReference Include="../Skua.Core.Interfaces/Skua.Core.Interfaces.csproj" />
        <ProjectReference Include="../Skua.Core.Models/Skua.Core.Models.csproj" />
        <ProjectReference Include="../Skua.Shared.Avalonia/Skua.Shared.Avalonia.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="QuestData.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="AdvancedSkills.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <None Include="../Skua.AS3/skua/bin/skua.swf" Link="skua.swf" Condition="Exists('../Skua.AS3/skua/bin/skua.swf')">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <Target Name="BuildRuffleNative" BeforeTargets="CoreCompile" Condition="'$(TargetFramework)' == 'net10.0' and '$(OS)' != 'Windows_NT' and '$(RuffleRustTarget)' != ''">
        <Exec Command="cargo build --release --target $(RuffleRustTarget)" WorkingDirectory="$(MSBuildProjectDirectory)/../Skua.Ruffle.Native" />
        <MakeDir Directories="$(OutDir)Assemblies/runtimes/$(RuntimeIdentifier)/native" />
        <Copy SourceFiles="$(MSBuildProjectDirectory)/../Skua.Ruffle.Native/target/$(RuffleRustTarget)/release/libskua_ruffle_native.dylib"
              DestinationFolder="$(OutDir)Assemblies/runtimes/$(RuntimeIdentifier)/native" />
    </Target>

    <Target Name="CopyRuffleNativeToPublish" AfterTargets="Publish" Condition="'$(TargetFramework)' == 'net10.0' and '$(OS)' != 'Windows_NT' and '$(RuffleRustTarget)' != ''">
        <MakeDir Directories="$(PublishDir)Assemblies/runtimes/$(RuntimeIdentifier)/native" />
        <Copy SourceFiles="$(MSBuildProjectDirectory)/../Skua.Ruffle.Native/target/$(RuffleRustTarget)/release/libskua_ruffle_native.dylib"
              DestinationFolder="$(PublishDir)Assemblies/runtimes/$(RuntimeIdentifier)/native" />
    </Target>

</Project>