<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Skua.Shared.Avalonia.Controls.Shell;assembly=Skua.Shared.Avalonia"
        x:Class="Skua.Plugin.Omniscope.OmniscopeWindow"
        Classes="skua"
        Title="OMNISCOPE | Live Game Intelligence"
        Width="1480" Height="940"
        MinWidth="1100" MinHeight="700"
        Background="#080D18"
        SystemDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="32"
        WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="Auto,*" Background="#080D18">
        <shell:WindowTitleBar Grid.Row="0" TitleText="OMNISCOPE  /  LIVE GAME INTELLIGENCE" />
        <Grid Grid.Row="1" Margin="18" RowDefinitions="Auto,Auto,*" RowSpacing="14">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="3">
                    <TextBlock Text="OMNISCOPE" FontSize="26" FontWeight="Black" Foreground="#E6F7FF" />
                    <TextBlock Text="VIBESKUA  /  GAME STATE OBSERVATORY" FontSize="10" CharacterSpacing="2" Foreground="#54DDF5" />
                </StackPanel>
                <Border Grid.Column="1" BorderBrush="#24516A" BorderThickness="1" CornerRadius="6" Padding="14,8" VerticalAlignment="Center" Background="#10202D">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Ellipse Width="8" Height="8" Fill="#49E6B1" VerticalAlignment="Center" />
                        <TextBlock x:Name="ConnectionText" Text="INITIALIZING TELEMETRY" Foreground="#BDEFFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="ClockText" Text="--:--:--" Foreground="#54DDF5" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                <Border Background="#101B2A" BorderBrush="#21445B" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel Spacing="4"><TextBlock Text="WORLD" Foreground="#6D9DB5" FontSize="10" CharacterSpacing="1.5"/><TextBlock x:Name="MapMetric" Text="--" Foreground="#E8F8FF" FontSize="19" FontWeight="Bold"/><TextBlock x:Name="RoomMetric" Text="Awaiting map" Foreground="#79B8CE" FontSize="11"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#101B2A" BorderBrush="#21445B" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel Spacing="4"><TextBlock Text="PLAYER VITALS" Foreground="#6D9DB5" FontSize="10" CharacterSpacing="1.5"/><TextBlock x:Name="VitalsMetric" Text="-- / -- HP" Foreground="#E8F8FF" FontSize="19" FontWeight="Bold"/><TextBlock x:Name="ManaMetric" Text="-- / -- MP" Foreground="#79B8CE" FontSize="11"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#101B2A" BorderBrush="#21445B" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel Spacing="4"><TextBlock Text="ENTITY FIELD" Foreground="#6D9DB5" FontSize="10" CharacterSpacing="1.5"/><TextBlock x:Name="EntityMetric" Text="0" Foreground="#E8F8FF" FontSize="19" FontWeight="Bold"/><TextBlock x:Name="EntitySubMetric" Text="Monsters in current map" Foreground="#79B8CE" FontSize="11"/></StackPanel>
                </Border>
                <Border Grid.Column="3" Background="#101B2A" BorderBrush="#21445B" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel Spacing="4"><TextBlock Text="PLAYER POSITION" Foreground="#6D9DB5" FontSize="10" CharacterSpacing="1.5"/><TextBlock x:Name="PositionMetric" Text="X --  /  Y --" Foreground="#E8F8FF" FontSize="19" FontWeight="Bold"/><TextBlock x:Name="CellMetric" Text="Cell --  /  Pad --" Foreground="#79B8CE" FontSize="11"/></StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="1.05*,1.3*,1.1*" ColumnSpacing="14">
                <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="PLAYER TELEMETRY" Foreground="#65DDF4" FontSize="12" FontWeight="Bold" CharacterSpacing="1"/><TextBlock Text=" / LIVE" Foreground="#4B7D91" FontSize="10" VerticalAlignment="Center"/></StackPanel>
                    <Border Grid.Row="1" Background="#0D1725" BorderBrush="#1C3B50" BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel Spacing="13">
                            <StackPanel Spacing="3"><TextBlock Text="IDENTITY" Foreground="#54869D" FontSize="10"/><TextBlock x:Name="PlayerNameText" Text="Waiting for player session" Foreground="#E6F7FF" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="PlayerClassText" Text="Class: unavailable" Foreground="#8AB7C9" FontSize="12"/></StackPanel>
                            <Border Height="1" Background="#1C3B50"/>
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="8">
                                <StackPanel><TextBlock Text="LEVEL" Foreground="#54869D" FontSize="10"/><TextBlock x:Name="LevelText" Text="--" Foreground="#E6F7FF" FontSize="16"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="STATE" Foreground="#54869D" FontSize="10"/><TextBlock x:Name="StateText" Text="UNKNOWN" Foreground="#E6F7FF" FontSize="16"/></StackPanel>
                                <StackPanel Grid.Row="1"><TextBlock Text="GOLD" Foreground="#54869D" FontSize="10"/><TextBlock x:Name="GoldText" Text="--" Foreground="#E6F7FF" FontSize="16"/></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="ADVENTURE COINS" Foreground="#54869D" FontSize="10"/><TextBlock x:Name="CoinsText" Text="--" Foreground="#E6F7FF" FontSize="16"/></StackPanel>
                                <StackPanel Grid.Row="2"><TextBlock Text="GUILD" Foreground="#54869D" FontSize="10"/><TextBlock x:Name="GuildText" Text="--" Foreground="#E6F7FF" FontSize="13"/></StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1"><TextBlock Text="SERVER" Foreground="#54869D" FontSize="10"/><TextBlock x:Name="ServerText" Text="--" Foreground="#E6F7FF" FontSize="13"/></StackPanel>
                            </Grid>
                            <Border Height="1" Background="#1C3B50"/>
                            <StackPanel Spacing="5"><TextBlock Text="SESSION OBSERVATIONS" Foreground="#54869D" FontSize="10"/><TextBlock x:Name="SessionText" Text="Telemetry will populate as the game exposes state." Foreground="#9CC5D5" FontSize="12" TextWrapping="Wrap"/></StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="8">
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="ENTITY INTELLIGENCE" Foreground="#65DDF4" FontSize="12" FontWeight="Bold" CharacterSpacing="1"/><TextBlock Grid.Column="1" Text="CURRENT MAP" Foreground="#4B7D91" FontSize="10"/></Grid>
                    <Border Grid.Row="1" Background="#0D1725" BorderBrush="#1C3B50" BorderThickness="1" CornerRadius="6" Padding="10">
                        <Grid RowDefinitions="Auto,*">
                            <Grid ColumnDefinitions="*,70,70,65" Margin="4,4,8,10">
                                <TextBlock Text="ENTITY / CELL" Foreground="#54869D" FontSize="10"/>
                                <TextBlock Grid.Column="1" Text="HP" Foreground="#54869D" FontSize="10" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="STATE" Foreground="#54869D" FontSize="10" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="ID" Foreground="#54869D" FontSize="10" HorizontalAlignment="Right"/>
                            </Grid>
                            <ListBox x:Name="EntityList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#D7F1FA">
                                <ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,70,70,65" Margin="3,5"><StackPanel Spacing="2"><TextBlock Text="{Binding Name}" Foreground="#D7F1FA" FontSize="12"/><TextBlock Text="{Binding Cell}" Foreground="#628FA3" FontSize="10"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Health}" Foreground="#9ED8E8" FontSize="11" HorizontalAlignment="Right"/><TextBlock Grid.Column="2" Text="{Binding State}" Foreground="#9ED8E8" FontSize="11" HorizontalAlignment="Right"/><TextBlock Grid.Column="3" Text="{Binding Id}" Foreground="#6F9BAE" FontSize="11" HorizontalAlignment="Right"/></Grid></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="8">
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="EVENT CHRONOLOGY" Foreground="#65DDF4" FontSize="12" FontWeight="Bold" CharacterSpacing="1"/><TextBlock x:Name="EventCountText" Grid.Column="1" Text="0 EVENTS" Foreground="#4B7D91" FontSize="10"/></Grid>
                    <Border Grid.Row="1" Background="#0D1725" BorderBrush="#1C3B50" BorderThickness="1" CornerRadius="6" Padding="12">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Text="Observed state transitions  /  newest first" Foreground="#628FA3" FontSize="10" Margin="2,2,2,10"/>
                            <ListBox x:Name="EventList" Grid.Row="1" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate><DataTemplate><StackPanel Spacing="3" Margin="2,5"><Grid ColumnDefinitions="Auto,*"><TextBlock Text="{Binding Time}" Foreground="#4CCFEA" FontSize="10" FontFamily="Consolas"/><TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="#D9F2FA" FontSize="11" Margin="10,0,0,0"/></Grid><TextBlock Text="{Binding Detail}" Foreground="#719CAF" FontSize="10" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>