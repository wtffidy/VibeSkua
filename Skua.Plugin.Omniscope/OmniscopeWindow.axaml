<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Skua.Shared.Avalonia.Controls.Shell;assembly=Skua.Shared.Avalonia"
        x:Class="Skua.Plugin.Omniscope.OmniscopeWindow"
        Classes="skua"
        Title="OMNISCOPE | Live Game Intelligence"
        Width="1400" Height="900"
        MinWidth="1080" MinHeight="700"
        Background="#070B14"
        SystemDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="32"
        WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="Auto,*" Background="#070B14">
        <shell:WindowTitleBar Grid.Row="0" TitleText="OMNISCOPE  /  LIVE GAME INTELLIGENCE" />
        <TabControl Grid.Row="1" Background="#070B14" BorderThickness="0">
            <TabItem Header="LIVE OBSERVATORY">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="22" MinWidth="0" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="14">
                <Grid Grid.Row="0" MinWidth="0" ColumnDefinitions="*,Auto" ColumnSpacing="18">
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="4" Height="34" Background="#39DDF5" CornerRadius="2"/>
                            <StackPanel Spacing="0">
                                <TextBlock Text="OMNISCOPE" FontSize="28" FontWeight="Black" Foreground="#E9FAFF"/>
                                <TextBlock Text="VIBESKUA  /  GAME STATE OBSERVATORY" FontSize="10" Foreground="#58CDEB"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="A live operational picture of the world, your avatar, and everything the client exposes." Foreground="#66899D" FontSize="11" Margin="16,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" BorderBrush="#24566B" BorderThickness="1" CornerRadius="8" Padding="16,10" VerticalAlignment="Center" Background="#102130">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Ellipse x:Name="ConnectionIndicator" Width="9" Height="9" Fill="#F0B95A" VerticalAlignment="Center"/>
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="ConnectionText" Text="INITIALIZING TELEMETRY" Foreground="#C8F3FF" FontSize="12" FontWeight="Bold"/>
                                <TextBlock x:Name="ClockText" Text="--:--:--" Foreground="#58CDEB" FontSize="11" FontFamily="Consolas"/>
                            </StackPanel>
                            <Border Width="1" Height="34" Background="#28536A"/>
                            <StackPanel Spacing="3">
                                <TextBlock Text="REFRESH RATE" Foreground="#79B8CE" FontSize="9" FontWeight="SemiBold"/>
                                <ComboBox x:Name="TelemetryRateBox" Width="100" SelectedIndex="2" SelectionChanged="TelemetryRateBox_SelectionChanged">
                                    <ComboBoxItem Content="250 ms" Tag="250"/>
                                    <ComboBoxItem Content="500 ms" Tag="500"/>
                                    <ComboBoxItem Content="750 ms" Tag="750"/>
                                    <ComboBoxItem Content="1 second" Tag="1000"/>
                                    <ComboBoxItem Content="2 seconds" Tag="2000"/>
                                    <ComboBoxItem Content="5 seconds" Tag="5000"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" MinWidth="0" ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                    <Border MinWidth="0" ClipToBounds="True" Background="#101D2B" BorderBrush="#25485D" BorderThickness="1" CornerRadius="8" Padding="15">
                        <Grid MinWidth="0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Width="34" Height="34" CornerRadius="8" Background="#17394A" VerticalAlignment="Center"><TextBlock Text="◈" Foreground="#55DDF4" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="WORLD / INSTANCE" Foreground="#6E9CB0" FontSize="9" TextWrapping="Wrap"/><TextBlock x:Name="MapMetric" Text="Awaiting world" Foreground="#E8F8FF" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="RoomMetric" Text="Room --  /  -- players" Foreground="#79B8CE" FontSize="10" TextWrapping="Wrap"/></StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" MinWidth="0" ClipToBounds="True" Background="#101D2B" BorderBrush="#25485D" BorderThickness="1" CornerRadius="8" Padding="15">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Width="34" Height="34" CornerRadius="8" Background="#17394A" VerticalAlignment="Center"><TextBlock Text="♥" Foreground="#FF8297" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="VITALITY" Foreground="#6E9CB0" FontSize="9"/><TextBlock x:Name="VitalsMetric" Text="-- / -- HP" Foreground="#E8F8FF" FontSize="17" FontWeight="Bold"/><Border Height="4" Background="#263847" CornerRadius="2"><Border x:Name="HealthProgressBar" HorizontalAlignment="Left" Width="0" Background="#F16F87" CornerRadius="2"/></Border></StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" MinWidth="0" ClipToBounds="True" Background="#101D2B" BorderBrush="#25485D" BorderThickness="1" CornerRadius="8" Padding="15">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Width="34" Height="34" CornerRadius="8" Background="#17394A" VerticalAlignment="Center"><TextBlock Text="⌖" Foreground="#6DDCFF" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="ENTITY FIELD" Foreground="#6E9CB0" FontSize="9" TextWrapping="Wrap"/><TextBlock x:Name="EntityMetric" Text="0" Foreground="#E8F8FF" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="EntitySubMetric" Text="No entities observed" Foreground="#79B8CE" FontSize="10" TextWrapping="Wrap"/></StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="3" MinWidth="0" ClipToBounds="True" Background="#101D2B" BorderBrush="#25485D" BorderThickness="1" CornerRadius="8" Padding="15">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Width="34" Height="34" CornerRadius="8" Background="#17394A" VerticalAlignment="Center"><TextBlock Text="⌁" Foreground="#B49AFF" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="POSITION / CELL" Foreground="#6E9CB0" FontSize="9" TextWrapping="Wrap"/><TextBlock x:Name="PositionMetric" Text="X --  /  Y --" Foreground="#E8F8FF" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="CellMetric" Text="Cell --  /  Pad --" Foreground="#79B8CE" FontSize="10" TextWrapping="Wrap"/></StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" MinWidth="0" ClipToBounds="True" ColumnDefinitions="1*,1.15*,1.15*" ColumnSpacing="14" MinHeight="410">
                    <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="8">
                        <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="01" Foreground="#3DD7F2" FontSize="10" FontWeight="Bold"/><TextBlock Text="AVATAR TELEMETRY" Foreground="#BCEAF5" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="AvatarFollowStatus" Text="LIVE" Foreground="#4CCCA8" FontSize="9" VerticalAlignment="Center"/></StackPanel><Button x:Name="AvatarFollowButton" Grid.Column="1" Content="PAUSE" MinWidth="72" Padding="9,4" FontSize="9" Background="#122C3D" BorderBrush="#28566B" BorderThickness="1" Foreground="#70DFF4" Click="AvatarFollowButton_Click"/></Grid>
                        <Border Grid.Row="1" MinWidth="0" ClipToBounds="True" Background="#0D1724" BorderBrush="#203E51" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="3"><TextBlock Text="IDENTITY" Foreground="#5F8FA5" FontSize="9"/><TextBlock x:Name="PlayerNameText" Text="Waiting for player session" Foreground="#ECFAFF" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="PlayerClassText" Text="Class: unavailable" Foreground="#83B8CA" FontSize="11"/></StackPanel>
                                <StackPanel Spacing="5"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="HEALTH" Foreground="#6C98AA" FontSize="9"/><TextBlock x:Name="HealthText" Grid.Column="1" Text="-- / --" Foreground="#F39AA8" FontSize="10"/></Grid><Border Height="7" Background="#263442" CornerRadius="4"><Border x:Name="HealthDetailBar" Width="0" HorizontalAlignment="Left" Background="#F16F87" CornerRadius="4"/></Border></StackPanel>
                                <StackPanel Spacing="5"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="MANA" Foreground="#6C98AA" FontSize="9"/><TextBlock x:Name="ManaText" Grid.Column="1" Text="-- / --" Foreground="#8BCFFF" FontSize="10"/></Grid><Border Height="7" Background="#263442" CornerRadius="4"><Border x:Name="ManaProgressBar" Width="0" HorizontalAlignment="Left" Background="#53B8F5" CornerRadius="4"/></Border></StackPanel>
                                <Border Height="1" Background="#203E51"/>
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="8">
                                    <StackPanel><TextBlock Text="LEVEL / XP" Foreground="#5F8FA5" FontSize="9"/><TextBlock x:Name="LevelText" Text="--" Foreground="#E7F8FF" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="XpText" Text="XP unavailable" Foreground="#78A8BA" FontSize="9"/><Border Height="4" Background="#263442" CornerRadius="2" Margin="0,4,0,0"><Border x:Name="XpProgressBar" Width="0" HorizontalAlignment="Left" Background="#55DDF4" CornerRadius="2"/></Border></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="PLAYER STATE" Foreground="#5F8FA5" FontSize="9"/><TextBlock x:Name="StateText" Text="UNKNOWN" Foreground="#E7F8FF" FontSize="16" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Grid.Row="1"><TextBlock Text="GOLD" Foreground="#5F8FA5" FontSize="9"/><TextBlock x:Name="GoldText" Text="--" Foreground="#F4D58B" FontSize="15"/></StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="ADVENTURE COINS" Foreground="#5F8FA5" FontSize="9"/><TextBlock x:Name="CoinsText" Text="--" Foreground="#E7F8FF" FontSize="15"/></StackPanel>
                                    <StackPanel Grid.Row="2"><TextBlock Text="GUILD" Foreground="#5F8FA5" FontSize="9"/><TextBlock x:Name="GuildText" Text="--" Foreground="#E7F8FF" FontSize="12"/></StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1"><TextBlock Text="SERVER" Foreground="#5F8FA5" FontSize="9"/><TextBlock x:Name="ServerText" Text="--" Foreground="#E7F8FF" FontSize="12"/></StackPanel>
                                </Grid>
                                <Border Height="1" Background="#203E51"/>
                                <StackPanel Spacing="4"><TextBlock Text="SESSION SNAPSHOT" Foreground="#5F8FA5" FontSize="9"/><TextBlock x:Name="SessionText" Text="Telemetry will populate as the game exposes state." Foreground="#9CC5D5" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="1" MinWidth="0" RowDefinitions="Auto,*" RowSpacing="8">
                        <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="02" Foreground="#3DD7F2" FontSize="10" FontWeight="Bold"/><TextBlock Text="ENTITY INTELLIGENCE" Foreground="#BCEAF5" FontSize="11" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="SELECT TO INSPECT" Foreground="#527D91" FontSize="9" VerticalAlignment="Center"/><Button x:Name="EntityFollowButton" Content="PAUSE" MinWidth="72" Padding="9,4" FontSize="9" Background="#122C3D" BorderBrush="#28566B" BorderThickness="1" Foreground="#70DFF4" Click="EntityFollowButton_Click"/></StackPanel></Grid>
                        <Border Grid.Row="1" MinWidth="0" ClipToBounds="True" Background="#0D1724" BorderBrush="#203E51" BorderThickness="1" CornerRadius="8" Padding="10">
                            <Grid RowDefinitions="Auto,Auto,*,Auto">
                                <Grid ColumnDefinitions="*,76,66,58" Margin="4,4,8,10"><TextBlock Text="ENTITY / CELL" Foreground="#5F8FA5" FontSize="9"/><TextBlock Grid.Column="1" Text="HP" Foreground="#5F8FA5" FontSize="9" HorizontalAlignment="Right"/><TextBlock Grid.Column="2" Text="STATE" Foreground="#5F8FA5" FontSize="9" HorizontalAlignment="Right"/><TextBlock Grid.Column="3" Text="ID" Foreground="#5F8FA5" FontSize="9" HorizontalAlignment="Right"/></Grid>
                                <TextBox x:Name="EntitySearchBox" Grid.Row="1" Watermark="Filter entities by name, ID, or cell..." TextChanged="EntitySearchBox_TextChanged" Margin="2,0,2,8" Background="#111F2D" Foreground="#D7F1FA" BorderBrush="#28536A" FontSize="11"/><ListBox x:Name="EntityList" Grid.Row="2" Background="Transparent" BorderThickness="0" Foreground="#D7F1FA">
                                    <ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,76,66,58" Margin="3,5"><StackPanel Spacing="2"><TextBlock Text="{Binding Name}" Foreground="#D7F1FA" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding Cell}" Foreground="#628FA3" FontSize="9"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Health}" Foreground="#9ED8E8" FontSize="10" HorizontalAlignment="Right"/><TextBlock Grid.Column="2" Text="{Binding State}" Foreground="#9ED8E8" FontSize="9" HorizontalAlignment="Right"/><TextBlock Grid.Column="3" Text="{Binding Id}" Foreground="#6F9BAE" FontSize="9" HorizontalAlignment="Right"/></Grid></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <Border Grid.Row="3" Margin="0,8,0,0" Padding="11" Background="#122333" BorderBrush="#28536A" BorderThickness="1" CornerRadius="6">
                                    <StackPanel Spacing="4"><TextBlock Text="SELECTED ENTITY" Foreground="#5F8FA5" FontSize="9"/><TextBlock x:Name="SelectedEntityText" Text="Select a monster to inspect its live properties." Foreground="#E5F8FF" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="SelectedEntityDetailsText" Text="Read-only entity inspection" Foreground="#85B7C9" FontSize="10" TextWrapping="Wrap"/></StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="2" MinWidth="0" RowDefinitions="Auto,*" RowSpacing="8">
                        <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="03" Foreground="#3DD7F2" FontSize="10" FontWeight="Bold"/><TextBlock Text="EVENT CHRONOLOGY" Foreground="#BCEAF5" FontSize="11" FontWeight="Bold"/></StackPanel><Button x:Name="EventFollowButton" Grid.Column="1" Content="PAUSE" MinWidth="72" Padding="9,4" FontSize="9" Background="#122C3D" BorderBrush="#28566B" BorderThickness="1" Foreground="#70DFF4" Click="EventFollowButton_Click"/></Grid>
                        <Border Grid.Row="1" MinWidth="0" ClipToBounds="True" Background="#0D1724" BorderBrush="#203E51" BorderThickness="1" CornerRadius="8" Padding="12">
                            <Grid RowDefinitions="Auto,*">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Observed state transitions / newest first" Foreground="#628FA3" FontSize="9"/>
                                    <TextBlock x:Name="EventCountText" Grid.Column="1" Text="0 EVENTS" Foreground="#4CCFEA" FontSize="9"/>
                                </Grid>
                                <ListBox x:Name="EventList" Grid.Row="1" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" Margin="0,8,0,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="3" Margin="2,5">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="{Binding Time}" Foreground="#4CCFEA" FontSize="9" FontFamily="Consolas"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayCategory}" Foreground="#D9F2FA" FontSize="10" Margin="10,0,0,0"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Detail}" Foreground="#719CAF" FontSize="9" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Grid.Row="3" MinWidth="0" ClipToBounds="True" ColumnDefinitions="*,*,*,*" ColumnSpacing="14" MinHeight="250">
                    <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="8">
                        <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="04" Foreground="#3DD7F2" FontSize="10" FontWeight="Bold"/><TextBlock Text="WORLD ROSTER" Foreground="#BCEAF5" FontSize="11" FontWeight="Bold"/></StackPanel><Button x:Name="PlayerFollowButton" Grid.Column="1" Content="PAUSE" MinWidth="72" Padding="9,4" FontSize="9" Background="#122C3D" BorderBrush="#28566B" BorderThickness="1" Foreground="#70DFF4" Click="PlayerFollowButton_Click"/></Grid>
                        <Border Grid.Row="1" MinWidth="0" ClipToBounds="True" Background="#0D1724" BorderBrush="#203E51" BorderThickness="1" CornerRadius="8" Padding="12"><Grid RowDefinitions="Auto,*"><TextBlock x:Name="RosterMetric" Text="Players in instance: --" Foreground="#628FA3" FontSize="9"/><ListBox x:Name="PlayerList" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,6,0,0"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#D7F1FA" FontSize="11" Margin="3,5"/></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
                    </Grid>
                    <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="05" Foreground="#3DD7F2" FontSize="10" FontWeight="Bold"/><TextBlock Text="ACTIVE AURAS" Foreground="#BCEAF5" FontSize="11" FontWeight="Bold"/></StackPanel>
                        <Border Grid.Row="1" Background="#0D1724" BorderBrush="#203E51" BorderThickness="1" CornerRadius="8" Padding="12"><Grid RowDefinitions="Auto,*"><TextBlock x:Name="AuraMetric" Text="Self effects: 0" Foreground="#628FA3" FontSize="9"/><ListBox x:Name="AuraList" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,6,0,0"><ListBox.ItemTemplate><DataTemplate><StackPanel Spacing="2" Margin="3,4"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Name}" Foreground="#D7F1FA" FontSize="10" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding Stacks}" Foreground="#62DDF1" FontSize="9"/></Grid><TextBlock Text="{Binding Duration}" Foreground="#719CAF" FontSize="9"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
                    </Grid>
                    <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="06" Foreground="#3DD7F2" FontSize="10" FontWeight="Bold"/><TextBlock Text="SKILL MATRIX" Foreground="#BCEAF5" FontSize="11" FontWeight="Bold"/></StackPanel>
                        <Border Grid.Row="1" Background="#0D1724" BorderBrush="#203E51" BorderThickness="1" CornerRadius="8" Padding="12"><Grid RowDefinitions="Auto,*"><TextBlock x:Name="SkillMetric" Text="Combat engine: idle" Foreground="#628FA3" FontSize="9"/><ListBox x:Name="SkillList" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,6,0,0"><ListBox.ItemTemplate><DataTemplate><StackPanel Spacing="2" Margin="3,4"><Grid ColumnDefinitions="Auto,*,Auto"><TextBlock Text="{Binding Slot}" Foreground="#4CCFEA" FontSize="9"/><TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#D7F1FA" FontSize="10" Margin="8,0,0,0"/><TextBlock Grid.Column="2" Text="{Binding Cooldown}" Foreground="#83B8CA" FontSize="9"/></Grid><TextBlock Text="{Binding Description}" Foreground="#719CAF" FontSize="9" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
                    </Grid>
                    <Grid Grid.Column="3" MinWidth="0" RowDefinitions="Auto,*" RowSpacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="07" Foreground="#3DD7F2" FontSize="10" FontWeight="Bold"/><TextBlock Text="SESSION ANALYTICS" Foreground="#BCEAF5" FontSize="11" FontWeight="Bold"/></StackPanel>
                        <Border Grid.Row="1" MinWidth="0" ClipToBounds="True" Background="#0D1724" BorderBrush="#203E51" BorderThickness="1" CornerRadius="8" Padding="13"><StackPanel Spacing="10"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="SESSION TIME" Foreground="#5F8FA5" FontSize="9"/><TextBlock x:Name="SessionTimeMetric" Grid.Column="1" Text="--:--:--" Foreground="#E7F8FF" FontSize="12" FontWeight="Bold"/></Grid><Grid ColumnDefinitions="*,Auto"><TextBlock Text="KILLS" Foreground="#5F8FA5" FontSize="9"/><TextBlock x:Name="KillsMetric" Grid.Column="1" Text="0" Foreground="#E7F8FF" FontSize="13"/></Grid><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Observed Drops" Foreground="#5F8FA5" FontSize="9"/><TextBlock x:Name="DropsMetric" Grid.Column="1" Text="0" Foreground="#E7F8FF" FontSize="13"/></Grid><Grid ColumnDefinitions="*,Auto"><TextBlock Text="DEATHS" Foreground="#5F8FA5" FontSize="9"/><TextBlock x:Name="DeathsMetric" Grid.Column="1" Text="0" Foreground="#E7F8FF" FontSize="13"/></Grid><Grid ColumnDefinitions="*,Auto"><TextBlock Text="KILLS / MIN" Foreground="#5F8FA5" FontSize="9"/><TextBlock x:Name="KpmMetric" Grid.Column="1" Text="0.0" Foreground="#75E1C0" FontSize="13"/></Grid><Border Height="1" Background="#203E51"/><Grid ColumnDefinitions="*,Auto"><TextBlock Text="INVENTORY" Foreground="#5F8FA5" FontSize="9"/><TextBlock x:Name="InventoryMetric" Grid.Column="1" Text="-- / --" Foreground="#E7F8FF" FontSize="11"/></Grid><Border Height="6" Background="#263442" CornerRadius="3"><Border x:Name="InventoryProgressBar" Width="0" HorizontalAlignment="Left" Background="#B49AFF" CornerRadius="3"/></Border><TextBlock x:Name="QuestMetric" Text="Quests: -- active / -- ready" Foreground="#83B8CA" FontSize="9"/><ListBox x:Name="QuestList" Height="58" Background="Transparent" BorderThickness="0" Margin="0,2,0,0"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#B6D7E2" FontSize="9" Margin="2,3" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="INVENTORY SNAPSHOT" Foreground="#5F8FA5" FontSize="9" Margin="0,4,0,0"/><ListBox x:Name="InventoryList" Height="78" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" Margin="2,3"><TextBlock Text="{Binding Name}" Foreground="#B6D7E2" FontSize="9" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding Quantity}" Foreground="#62DDF1" FontSize="9"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
                    </Grid>
                </Grid>

                <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
                    <TextBlock Text="OMNISCOPE  /  READ-ONLY TELEMETRY  /  SOURCE: PUBLIC VIBESKUA GAME INTERFACES" Foreground="#456A7D" FontSize="9"/>
                    <TextBlock Grid.Column="1" Text="750 MS POLL  •  BOUNDED EVENT HISTORY" Foreground="#456A7D" FontSize="9"/>
                </Grid>
                </Grid>
            </ScrollViewer>
            </TabItem>
            <TabItem Header="DATA INTELLIGENCE">
                <Grid Margin="18" MinWidth="0" RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="4" Height="30" Background="#4BE3F7" CornerRadius="2"/>
                                <StackPanel Spacing="0">
                                    <TextBlock Text="DATA INTELLIGENCE" FontSize="21" FontWeight="Bold" Foreground="#E9FAFF"/>
                                    <TextBlock Text="SEARCH THE GAME CLIENT AND MAP INDEX" FontSize="9" FontWeight="SemiBold" Foreground="#58CDEB"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Choose a workspace, search, then select a result. Available actions appear beside the details." FontSize="11" Foreground="#8BB3C4" TextWrapping="Wrap" Margin="14,2,0,0"/>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="REFRESH GAME DATA" Click="RefreshDataCatalog_Click" Margin="0,0,8,0"/>
                            <Button Content="EXPORT JSON" Click="ExportData_Click"/>
                        </WrapPanel>
                    </Grid>

                    <TabControl Grid.Row="1" Background="#081522" BorderBrush="#21485C" BorderThickness="1">
                        <TabItem Header="GAME SWF  /  GAME DATA">
                            <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
                                <Grid Grid.Row="0" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                    <Border Background="#102334" BorderBrush="#28536A" BorderThickness="1" CornerRadius="7" Padding="11">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border Width="34" Height="34" CornerRadius="7" Background="#173B50"><TextBlock Text="Q" Foreground="#62E4FA" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                            <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="SOURCE FILES" Foreground="#7EB5C8" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="SourceFileCountText" Text="0" Foreground="#E8FAFF" FontSize="21" FontWeight="Bold"/><TextBlock Text=" Decompiled ActionScript files" Foreground="#7C9FB0" FontSize="9"/></StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="1" Background="#102334" BorderBrush="#28536A" BorderThickness="1" CornerRadius="7" Padding="11">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border Width="34" Height="34" CornerRadius="7" Background="#332F50"><TextBlock Text="S" Foreground="#BBA8FF" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                            <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="CLIENT SYSTEMS" Foreground="#B3A5E9" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="ClientSystemCountText" Text="0" Foreground="#E8FAFF" FontSize="21" FontWeight="Bold"/><TextBlock Text="Distinct client code categories" Foreground="#7C9FB0" FontSize="9"/></StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="2" Background="#102334" BorderBrush="#28536A" BorderThickness="1" CornerRadius="7" Padding="11">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border Width="34" Height="34" CornerRadius="7" Background="#17443F"><TextBlock Text="{}" Foreground="#64E5C2" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                            <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="FUNCTIONS INDEXED" Foreground="#72D5BD" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="ClientFunctionCountText" Text="0" Foreground="#E8FAFF" FontSize="21" FontWeight="Bold"/><TextBlock Text="Functions across client source" Foreground="#7C9FB0" FontSize="9"/></StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="8">
                                    <TextBox x:Name="DataSearchBox" Grid.Row="0" MinHeight="46" Watermark="Search classes, functions, packets, UI, maps, client systems, or IDs..." TextChanged="DataSearchBox_TextChanged" Background="#0B1D2C" Foreground="#E5F8FF" BorderBrush="#3A9DB8" FontSize="14" Padding="13,10"/>
                                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,190" ColumnSpacing="10">
                                        <TextBlock Text="SHOW" Foreground="#7DB4C8" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="DataCategoryBox" Grid.Column="1" MinHeight="36" SelectedIndex="0" SelectionChanged="DataCategoryBox_SelectionChanged">
                                            <ComboBoxItem Content="All Client Code"/>
                                            <ComboBoxItem Content="Client Core"/>
                                            <ComboBoxItem Content="Network / API"/>
                                            <ComboBoxItem Content="Game UI"/>
                                            <ComboBoxItem Content="World / Map"/>
                                            <ComboBoxItem Content="Player / Avatar"/>
                                            <ComboBoxItem Content="Inventory / Items"/>
                                            <ComboBoxItem Content="Combat / Skills"/>
                                            <ComboBoxItem Content="Game Systems"/>
                                            <ComboBoxItem Content="Other Client Code"/>
                                        </ComboBox>
                                        <TextBlock Grid.Column="2" Text="SORT" Foreground="#7DB4C8" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="DataSortBox" Grid.Column="3" MinHeight="36" SelectedIndex="0" SelectionChanged="DataSortBox_SelectionChanged">
                                            <ComboBoxItem Content="Name (A-Z)"/>
                                            <ComboBoxItem Content="Name (Z-A)"/>
                                            <ComboBoxItem Content="Category"/>
                                            <ComboBoxItem Content="ID (low-high)"/>
                                            <ComboBoxItem Content="ID (high-low)"/>
                                        </ComboBox>
                                    </Grid>
                                </Grid>

                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="DecompileSwfButton" Content="INDEX GAME SWF" Click="DecompileSwf_Click"/>
                                        <TextBlock Text="Downloads and decompiles the latest AQW client, then indexes its ActionScript source." Foreground="#7FA9B8" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock x:Name="SwfSourceStatusText" Grid.Column="1" Text="GAME CLIENT NOT INDEXED" Foreground="#70B8CB" FontSize="9" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Grid.Row="3" ColumnDefinitions="0.92*,1.08*" ColumnSpacing="10" MinHeight="0">
                                    <Border Background="#0B1927" BorderBrush="#28536A" BorderThickness="1" CornerRadius="7" ClipToBounds="True" Padding="10">
                                        <Grid RowDefinitions="Auto,*">
                                            <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,8">
                                                <TextBlock Text="GAME RESULTS" Foreground="#BCEAF5" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock x:Name="DataResultMetric" Grid.Column="1" Text="0 MATCHES" Foreground="#5ADFF4" FontSize="9"/>
                                            </Grid>
                                            <ListBox x:Name="DataRecordList" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="DataRecordList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#102333" BorderBrush="#1D4258" BorderThickness="0,0,0,1" CornerRadius="4" Padding="10" Margin="1,3">
                                                            <StackPanel Spacing="4">
                                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                    <TextBlock Text="{Binding Name}" Foreground="#E4F8FF" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayCategory}" Foreground="#61D8EE" FontSize="9" VerticalAlignment="Top" TextWrapping="Wrap" MaxWidth="104" TextAlignment="Right"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding Summary}" Foreground="#91B7C7" FontSize="10" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="1" Background="#0B1927" BorderBrush="#28536A" BorderThickness="1" CornerRadius="7" ClipToBounds="True" Padding="12">
                                        <Grid RowDefinitions="Auto,Auto,Auto,*">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="SELECTED RESULT" Foreground="#5ADFF4" FontSize="9" FontWeight="Bold"/>
                                                <TextBlock x:Name="DataDetailTitle" Text="Choose a result on the left" Foreground="#E9FAFF" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="DataDetailMeta" Text="Details and source information will appear here." Foreground="#83B2C3" FontSize="10" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Border Grid.Row="1" Height="1" Background="#24485B" Margin="0,9,0,9"/>
                                            <TextBlock Grid.Row="2" Text="DECOMPILED ACTIONSCRIPT" Foreground="#8EB7C6" FontSize="9" FontWeight="Bold"/>
                                            <TextBox x:Name="DataDetailText" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="#071522" Foreground="#D0E7EF" BorderBrush="#1F4155" FontFamily="Segoe UI" FontSize="11" Padding="11" Text="Select a source file to inspect its classes, functions, and decompiled ActionScript."/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="MAP SWF  /  MAP DATA">
                            <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="MAP SWF LOOKUP" Foreground="#E9FAFF" FontSize="19" FontWeight="Bold"/>
                                        <TextBlock Text="Browse saved map-item links, scan map SWFs for shop IDs, and generate map-specific scripts." Foreground="#8BB3C4" FontSize="10" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="AnalyzeMapButton" Content="LOAD SAVED MAP INDEX" Click="AnalyzeMap_Click" Margin="0,0,6,0"/><Button x:Name="ScanMapShopsButton" Content="SCAN CURRENT MAP SHOPS" Click="ScanCurrentMapShops_Click" Margin="0,0,6,0"/><Button x:Name="GenerateCurrentMapQuestsButton" Content="GENERATE CURRENT MAP QUESTS" Click="GenerateCurrentMapQuests_Click"/></WrapPanel>
                                </Grid>

                                <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                    <Border Background="#102334" BorderBrush="#28536A" BorderThickness="1" CornerRadius="7" Padding="10">
                                        <StackPanel Spacing="2"><TextBlock Text="SAVED MAPS" Foreground="#70B8CB" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="MapSwfMapCountText" Text="0" Foreground="#E8FAFF" FontSize="21" FontWeight="Bold"/><TextBlock Text="Maps in local cache" Foreground="#7C9FB0" FontSize="9"/></StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#102334" BorderBrush="#28536A" BorderThickness="1" CornerRadius="7" Padding="10">
                                        <StackPanel Spacing="2"><TextBlock Text="MAP SHOPS" Foreground="#BBA8FF" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="MapShopRecordCountText" Text="0" Foreground="#E8FAFF" FontSize="21" FontWeight="Bold"/><TextBlock Text="IDs extracted from map SWFs" Foreground="#7C9FB0" FontSize="9"/></StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#102334" BorderBrush="#28536A" BorderThickness="1" CornerRadius="7" Padding="10">
                                        <StackPanel Spacing="2"><TextBlock Text="MAP ITEMS" Foreground="#70B8CB" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="MapItemRecordCountText" Text="0" Foreground="#E8FAFF" FontSize="21" FontWeight="Bold"/><TextBlock Text="Quest-linked map item references" Foreground="#7C9FB0" FontSize="9"/></StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="8">
                                    <TextBox x:Name="MapSearchBox" Grid.Row="0" MinHeight="46" Watermark="Search maps, shop IDs, map items, quest IDs, or files..." TextChanged="MapSearchBox_TextChanged" Background="#0B1D2C" Foreground="#E5F8FF" BorderBrush="#3A9DB8" FontSize="14" Padding="13,10"/>
                                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,190" ColumnSpacing="10">
                                        <TextBlock Text="MAPS" Foreground="#7DB4C8" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="MapCategoryBox" Grid.Column="1" MinHeight="36" SelectedIndex="0" SelectionChanged="MapCategoryBox_SelectionChanged">
                                            <ComboBoxItem Content="All maps"/>
                                            <ComboBoxItem Content="Current map"/>
                                            <ComboBoxItem Content="Map shops"/>
                                            <ComboBoxItem Content="Map items"/>
                                        </ComboBox>
                                        <TextBlock Grid.Column="2" Text="SORT" Foreground="#7DB4C8" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="MapSortBox" Grid.Column="3" MinHeight="36" SelectedIndex="0" SelectionChanged="MapSortBox_SelectionChanged">
                                            <ComboBoxItem Content="Map (A-Z)"/>
                                            <ComboBoxItem Content="Quest ID (low-high)"/>
                                            <ComboBoxItem Content="Map item ID (low-high)"/>
                                            <ComboBoxItem Content="Map item ID (high-low)"/>
                                            <ComboBoxItem Content="Shop ID (low-high)"/>
                                            <ComboBoxItem Content="Shop ID (high-low)"/>
                                        </ComboBox>
                                    </Grid>
                                </Grid>

                                <Grid Grid.Row="3" ColumnDefinitions="0.92*,1.08*" ColumnSpacing="10" MinHeight="0">
                                    <Border Background="#0B1927" BorderBrush="#28536A" BorderThickness="1" CornerRadius="7" ClipToBounds="True" Padding="10">
                                        <Grid RowDefinitions="Auto,*">
                                            <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,8">
                                                <TextBlock Text="MAP RESULTS" Foreground="#BCEAF5" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock x:Name="MapResultMetric" Grid.Column="1" Text="0 MAP RECORDS" Foreground="#5ADFF4" FontSize="9"/>
                                            </Grid>
                                            <ListBox x:Name="MapRecordList" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="MapRecordList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#102333" BorderBrush="#1D4258" BorderThickness="0,0,0,1" CornerRadius="4" Padding="10" Margin="1,3">
                                                            <StackPanel Spacing="4">
                                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                    <TextBlock Text="{Binding Name}" Foreground="#E4F8FF" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayCategory}" Foreground="#61D8EE" FontSize="9" VerticalAlignment="Top"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding Summary}" Foreground="#91B7C7" FontSize="10" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Metadata}" Foreground="#6A99AB" FontSize="9" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="1" Background="#0B1927" BorderBrush="#28536A" BorderThickness="1" CornerRadius="7" ClipToBounds="True" Padding="12">
                                        <Grid RowDefinitions="Auto,Auto,Auto,*">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="MAP / SHOP DETAILS" Foreground="#5ADFF4" FontSize="9" FontWeight="Bold"/>
                                                <TextBlock x:Name="MapDetailTitle" Text="Choose a map link on the left" Foreground="#E9FAFF" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="MapDetailMeta" Text="Map file and linked quest information will appear here." Foreground="#83B2C3" FontSize="10" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Border Grid.Row="1" Height="1" Background="#24485B" Margin="0,9,0,9"/>
                                            <WrapPanel Grid.Row="2"><Button x:Name="LoadMapShopButton" Content="LOAD SHOP" Click="LoadMapShop_Click" IsEnabled="False" Margin="0,0,6,5"/><Button x:Name="GenerateMergeShopButton" Content="GENERATE MERGE SHOP" Click="GenerateMergeShop_Click" IsEnabled="False" Margin="0,0,6,5"/><Button x:Name="GenerateMapQuestsButton" Content="GENERATE MAP QUESTS" Click="GenerateMapQuests_Click" IsEnabled="False" Margin="0,0,6,5"/></WrapPanel>
                                            <TextBox x:Name="MapDetailText" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="#071522" Foreground="#D0E7EF" BorderBrush="#1F4155" FontSize="11" Padding="11" Text="Load the saved map index for map items, or scan the currently joined map SWF to find its shop IDs."/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="2,0,2,0">
                        <TextBlock x:Name="DataStatusText" Text="Ready. Refresh game data or load the saved map index to begin." Foreground="#7FA9B8" FontSize="9" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="1" Text="LOCAL DATA  /  READ-ONLY UNTIL YOU CHOOSE AN ACTION" Foreground="#4D8397" FontSize="9" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>